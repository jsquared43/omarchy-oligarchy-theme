# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""
theme_background=false

# Main text color
theme[main_fg]="#e8ddb8"

# Title color for boxes
theme[title]="#fff6df"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d4af37"

# Background color of selected item in processes box
theme[selected_bg]="#2f4a2a"

# Foreground color of selected item in processes box
theme[selected_fg]="#fff6df"

# Color of inactive/disabled text
theme[inactive_fg]="#5c6b4f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d4af37"

# Box outline and divider line color
theme[cpu_box]="#8a9478"
theme[mem_box]="#8a9478"
theme[net_box]="#8a9478"
theme[proc_box]="#8a9478"
theme[div_line]="#3a5232"

# Gradient for all meters and graphs
theme[temp_start]="#e8c65a"
theme[temp_mid]="#d4af37"
theme[temp_end]="#b23a2e"

theme[cpu_start]="#68bd7d"
theme[cpu_mid]="#4f9d63"
theme[cpu_end]="#d4af37"

theme[free_start]="#4f9d63"
theme[free_mid]="#4f9d63"
theme[free_end]="#4f9d63"

theme[cached_start]="#5fa896"
theme[cached_mid]="#5fa896"
theme[cached_end]="#5fa896"

theme[available_start]="#e8c65a"
theme[available_mid]="#e8c65a"
theme[available_end]="#e8c65a"

theme[used_start]="#d4af37"
theme[used_mid]="#d4af37"
theme[used_end]="#d4af37"

theme[download_start]="#5fa896"
theme[download_mid]="#d4af37"
theme[download_end]="#e8c65a"

theme[upload_start]="#c9853c"
theme[upload_mid]="#d4af37"
theme[upload_end]="#e8c65a"
